{
  "name": "arnur-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:preview": "npm run build && wrangler pages dev out",
    "pages:deploy": "npm run build && wrangler pages deploy out --project-name arnur",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,mdx}\" \"*.{json,mjs,ts}\" \"mdx-components.tsx\" \".prettierrc.json\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,mdx}\" \"*.{json,mjs,ts}\" \"mdx-components.tsx\" \".prettierrc.json\" \"README.md\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.0",
    "framer-motion": "^12.23.12",
    "next": "^16.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.151.0"
  }
}
